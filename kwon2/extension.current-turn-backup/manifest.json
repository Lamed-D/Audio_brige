{
  "manifest_version": 3,
  "name": "VOICE BRIDGE",
  "description": "웹 영상에 사용자 요청형 AI 화면해설을 재생합니다.",
  "version": "0.2.0",
  "version_name": "0.2.0 · Boilerplate",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "offscreen",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_title": "VOICE BRIDGE 열기",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "VOICE BRIDGE 열기"
    },
    "announce-progress": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "현재 화면해설 생성 상태 확인"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://*.youtube.com/*"],
      "run_at": "document_end"
    }
  ]
}
