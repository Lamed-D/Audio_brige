    },
    {
      "start_ms": 7300,
      "end_ms": 10100,
      "text": "song 나와 아버지가"
    },
    {
      "start_ms": 10100,
      "end_ms": 12360,
      "text": "리버풀의 우선 지역에"
    },
    {
      "start_ms": 12360,
      "end_ms": 12360,
      "text": ""
    },
    {
      "start_ms": 12360,
