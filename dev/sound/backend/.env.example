OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# v1 manifest/job/audio API (비우면 backend/data 사용)
VOICE_BRIDGE_DATA_DIR=
VOICE_BRIDGE_RETRY_AFTER_MS=1500
VOICE_BRIDGE_MAX_REQUEST_BYTES=16777216
# 구형 frame/audio 업로드 API는 로컬 디버깅 때만 true로 설정
VOICE_BRIDGE_ENABLE_LEGACY_SESSION_API=false
# 배포 시 실제 chrome-extension://<extension-id>만 지정 (여러 개는 쉼표 구분)
VOICE_BRIDGE_CORS_ORIGINS=*
